# Copy to BE/.env (gitignored). Replace local placeholders; never commit secrets.
APP_MODE=demo
# Set this to your existing local Compose project before starting Docker.
COMPOSE_PROJECT_NAME=davel-trace-dev
POSTGRES_DB=davel_trace
POSTGRES_USER=davel
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_PORT=5437
DATABASE_URL=postgresql+psycopg://davel:CHANGE_ME_LOCAL_ONLY@127.0.0.1:5437/davel_trace
ALLOWED_ORIGINS=http://127.0.0.1:5501,http://localhost:5501

# Optional AI assistance. Deterministic planning works with provider disabled.
# Values: disabled | local | gemini | compatible
LLM_PROVIDER=disabled
LLM_PARSE_ENABLED=true
LLM_EXPLANATION_ENABLED=true
LLM_SHADOW_ENABLED=false
LLM_TIMEOUT_SECONDS=10
LLM_MAX_RETRIES=1

# Local Ollama mode
OLLAMA_URL=http://localhost:11434
JUDGE_MODEL=qwen3:14b

# Gemini Developer API mode. Create the key in Google AI Studio; never commit it.
GEMINI_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
# Leave empty to use Google's official OpenAI-compatible Gemini base URL.
LLM_API_URL=

# Generic compatible mode only (ignored by gemini/local/disabled).
LLM_API_KEY=
SNAPSHOT_DIR=BE/data/snapshots/danang-v1
SNAPSHOT_NAME=danang-v1-stable-35872c2
# Google Places (live-fetch option, deferred — needs billing-enabled key)
GOOGLE_PLACES_KEY=
# OSRM routing backend (empty = offline snapshot-matrix mode)
OSRM_BASE_URL=
# Legacy SQLite evidence import source only; production never selects it.
ACCEPTANCE_DB_PATH=BE/data/accepted_plans.db
# 0 disables automatic shadow sampling; allowed range 0..0.10
SHADOW_JUDGE_RATE=0

# Local demo/test only. Production mode rejects this flag.
IDENTITY_DEV_OUTBOX_ENABLED=true
IDENTITY_ACCESS_TTL_MINUTES=15
IDENTITY_REFRESH_TTL_DAYS=30
IDENTITY_VERIFICATION_TTL_HOURS=24
IDENTITY_RECOVERY_TTL_MINUTES=30
