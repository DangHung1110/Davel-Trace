# BE env template (T004). Copy to BE/.env (gitignored) — NEVER commit real keys.
# LLM_PROVIDER=local (default, Ollama demo day) | api (test env)
LLM_PROVIDER=local
OLLAMA_URL=http://localhost:11434
JUDGE_MODEL=qwen3:14b
SNAPSHOT_DIR=data/snapshots/danang-v1
SNAPSHOT_NAME=danang-v1
# Google Places (live-fetch option, deferred — needs billing-enabled key)
GOOGLE_PLACES_KEY=
# Deploy: APP_ENV=production closes CORS from localhost and the local test routers
# (review/repair/accept). CORS_ORIGINS = the app's origins, comma-separated.
APP_ENV=local
CORS_ORIGINS=
# OSRM routing backend (empty = offline snapshot-matrix mode)
OSRM_BASE_URL=
